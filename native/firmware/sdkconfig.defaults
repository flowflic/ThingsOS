CONFIG_IDF_TARGET="esp32s31"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# Metalio vendor flash timing: DIO 80 MHz.
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_GATT_CLIENT=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=4
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
# S31 BTDM can stall waiting for the modem to wake during HID discovery.
# Keep the controller awake until that path is verified on this board.
# CONFIG_BT_CTRL_SLEEP_ENABLE is not set
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=20480
CONFIG_COMPILER_STACK_CHECK_MODE_STRONG=y
CONFIG_CACHE_L1_DCACHE_LINE_SIZE=64
CONFIG_FREERTOS_HZ=1000
CONFIG_SPIRAM=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=n
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Metalio: octal PSRAM at 200 MHz (vendor sdkconfig).
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Prefer PSRAM for ordinary allocations above 1 KiB; explicit INTERNAL/DMA
# allocations and internal task stacks retain their SDK capability constraints.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_320=y
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_RX_BA_WIN=8
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER=n
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=32
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=1024
CONFIG_BOOTLOADER_CUSTOM_RESERVE_RTC=y
CONFIG_BOOTLOADER_CUSTOM_RESERVE_RTC_SIZE=0x10
CONFIG_BOOTLOADER_CUSTOM_RESERVE_RTC_IN_CRC=n
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU0=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
CONFIG_MBEDTLS_HARDWARE_MPI=y
# Panel scans block for hundreds of milliseconds per refresh.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=20

# Keep large TLS buffers and RSA working memory out of fragmented internal RAM.
CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC=n
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# Copy WiFi receive packets before handing them to the asynchronous IP stack.
CONFIG_LWIP_L2_TO_L3_COPY=y

# Software AES avoids internal DMA bounce allocations for PSRAM TLS records.
CONFIG_MBEDTLS_HARDWARE_AES=n

# Catch storage finalization memory overwrites at their first allocator boundary.
CONFIG_HEAP_POISONING_LIGHT=y
CONFIG_MBEDTLS_X509_CREATE_C=y
CONFIG_MBEDTLS_X509_CRT_WRITE_C=y
CONFIG_MBEDTLS_TLS_SERVER_AND_CLIENT=y
# Transfer HTTP, pairing HTTPS and the credential-free scan guide each own
# listener/control sockets; leave room for browser clients and DNS/API traffic.
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_ESP_HTTP_CLIENT_ENABLE_CUSTOM_TRANSPORT=y
# Wall-time idle runtime deltas for the two-core System application.
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_EXTRA_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# CONFIG_ESP_WIFI_SLP_IRAM_OPT is not set
# CONFIG_ESP_PHY_IRAM_OPT is not set
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=6
CONFIG_NVS_ALLOCATE_CACHE_IN_SPIRAM=y

CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# esp_cache_msync C2M holds a cross-core spinlock with interrupts off. SD DMA
# writebacks of whole PSRAM buffers delayed the LCD EOF refill (2026-11-20).
CONFIG_ESP_MM_CACHE_MSYNC_C2M_CHUNKED_OPS=y
CONFIG_ESP_MM_CACHE_MSYNC_C2M_CHUNKED_OPS_MAX_LEN=0x1000
# One BLE link (page turner / HID). S31 controller pools are INTERNAL|DMA; the
# defaults are sized for several links. Shrink them to keep the BLE start budget
# after the 3-buffer LCD ring (2026-11-20). Advertising reports use EVT buffers.
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=10
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=20
